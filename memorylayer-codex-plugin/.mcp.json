{
  "mcpServers": {
    "memorylayer": {
      "command": "memorylayer-mcp",
      "env": {
        "MEMORYLAYER_URL": "${MEMORYLAYER_URL:-http://localhost:61001}",
        "MEMORYLAYER_API_KEY": "${MEMORYLAYER_API_KEY:-}",
        "MEMORYLAYER_WORKSPACE_ID": "${MEMORYLAYER_WORKSPACE_ID:-}"
      }
    }
  }
}
